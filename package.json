{
  "name": "portfolio-site",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/check-project-data.mjs",
    "build": "ng build",
    "postbuild": "node scripts/generate-github-pages-routes.mjs && node scripts/check-sitemap-routes.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "serve:ssr:portfolioSite": "node dist/portfolio-site/server/server.mjs",
    "lint": "ng lint",
    "prepare": "test -d .git/hooks && cp .hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:smoke:live": "E2E_BASE_URL=https://brianrogstad.com playwright test --grep @smoke",
    "qa": "npm run lint && npm run lint:styles && npm run test && npm run e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.0.4",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/stylelint-plugin": "^4.0.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.9.9",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.13",
    "@angular-devkit/build-angular": {
      "http-proxy-middleware": "^3.0.7"
    }
  }
}
